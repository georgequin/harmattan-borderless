# Copy to .env for local (non-Docker) runs.
DATABASE_URL=postgresql://harmattan:harmattan@localhost:5432/harmattan?schema=public
PORT=3000
# Live FX provider (free, no key). Base currency must be USD.
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_TIMEOUT_MS=3000
# How long a live quote is reused before refreshing.
FX_CACHE_TTL_SECONDS=300
# After a provider failure, wait this long before trying it again.
FX_FAILURE_BACKOFF_SECONDS=30
